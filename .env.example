# =============================================================================
# CODEASTRA / URBANPULSE CONFIGURATION FILE
# =============================================================================

# --- 1. SUPABASE DATABASE CONFIGURATION ---
# Sign up free at https://supabase.com, create a project, then copy:
# Project Settings -> API -> Project URL & Project API Keys (anon public / service_role)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key-or-service-role-key

# --- 2. GOOGLE MAPS JAVASCRIPT API KEY ---
# Get your Google Maps key with Maps JavaScript API & Directions API enabled:
# https://console.cloud.google.com/google/maps-apis/credentials
# Note: CodeAstra automatically falls back to full-featured OpenStreetMap / Leaflet if this is omitted.
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# --- 3. SERVER CONFIGURATION ---
PORT=8000
HOST=127.0.0.1
DEBUG=True
