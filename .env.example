# =============================================================================
# CODEASTRA / URBANPULSE CONFIGURATION FILE
# =============================================================================

# --- 1. SUPABASE DATABASE CONFIGURATION ---
# Sign up free at https://supabase.com, create a project, then copy:
# Project Settings -> API -> Project URL & Project API Keys (anon public / service_role)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key-or-service-role-key

# --- 2. GOOGLE MAPS JAVASCRIPT API KEY ---
# Get your Google Maps key with Maps JavaScript API & Directions API enabled:
# https://console.cloud.google.com/google/maps-apis/credentials
# Note: CodeAstra automatically falls back to full-featured OpenStreetMap / Leaflet if this is omitted.
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# --- 3. FAST2SMS NOTIFICATION CONFIGURATION ---
# Sign up at https://www.fast2sms.com for an API key (dev/bulkV2 API, route=q).
# Note: Fast2SMS is a paid per-message service for Indian mobile numbers (+91).
# SMS sending is kept disabled by default (SMS_NOTIFICATIONS_ENABLED=false) to prevent accidental charges.
FAST2SMS_API_KEY=YOUR_FAST2SMS_API_KEY_HERE
FAST2SMS_BASE_URL=https://www.fast2sms.com/dev/bulkV2
FAST2SMS_ROUTE=q
SMS_NOTIFICATIONS_ENABLED=false
SMS_REQUEST_TIMEOUT_MS=8000

# --- 4. SERVER CONFIGURATION ---
PORT=8000
HOST=127.0.0.1
DEBUG=True
